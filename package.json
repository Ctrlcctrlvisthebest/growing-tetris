{
  "name": "growing-tetris",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.js tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "build:local": "node scripts/build.mjs --local",
    "dev": "npm run build:local && wrangler d1 migrations apply DB --local && wrangler dev --port 8796",
    "types": "wrangler types",
    "check": "npm run types && tsc --noEmit",
    "deploy": "npm run deploy:server",
    "deploy:server": "npm run build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.129.1"
  }
}
